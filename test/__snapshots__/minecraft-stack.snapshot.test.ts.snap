          "Fn::GetAtt": [
            "FleetManagerApiHandlerFFB1136C",
            "Arn",
          ],
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Join": [
            "",
            [
              "arn:aws:execute-api:us-east-1:123456789012:",
              {
                "Ref": "FleetManagerApiHttpApi8E0F49EE",

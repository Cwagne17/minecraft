        "UserData": {
          "Fn::Base64": "#!/bin/bash
echo "Waiting for volume to be attached..."
while [ ! -e /dev/xvdb ]; do sleep 1; done
sleep 5
echo "Setting up data volume..."
if ! blkid /dev/xvdb; then
  mkfs -t ext4 /dev/xvdb
fi
mkdir -p /minecraft
mount /dev/xvdb /minecraft
echo "/dev/xvdb /minecraft ext4 defaults,nofail 0 2" >> /etc/fstab
echo "Installing Docker..."
dnf install -y docker
systemctl enable docker
systemctl start docker
echo "Installing AWS CLI..."
dnf install -y awscli
echo "Fetching CurseForge API key from SSM..."
CF_API_KEY=$(aws ssm get-parameter --name "/minecraft/curseforge/apiKey" --query Parameter.Value --output text --region us-east-1)
echo "Starting Minecraft server container..."
docker run -d --restart=always --name minecraft \\
  -p 25565:25565 \\
  -e EULA=TRUE \\
  -e MEMORY=4G \\
  -e TYPE="AUTO_CURSEFORGE" -e EULA="TRUE" -e MEMORY="8G" -e CF_PAGE_URL="https://www.curseforge.com/minecraft/modpacks/better-mc-forge-bmc4" \\
  -e CF_API_KEY="$CF_API_KEY" \\
  -v /minecraft:/data \\
  itzg/minecraft-server
echo "Minecraft server setup complete!"",
